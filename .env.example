# Copy this file to .env for local development. On Vercel, set the same
# names under Project Settings → Environment Variables instead.

# --- Base de données (Postgres — Neon, Supabase, Vercel Postgres, etc.) ---
DATABASE_URL=postgres://user:password@host:5432/database
# Mettre "disable" seulement pour un Postgres local sans TLS.
# PGSSLMODE=disable

# --- Sessions ---
# Générer une valeur aléatoire longue, ex: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# URL publique de l'application (utilisée pour callback_url FedaPay, etc.)
APP_BASE_URL=https://votre-domaine.vercel.app

# --- FedaPay (paiement Mobile Money Afrique) ---
# Clé secrète de votre compte FedaPay (sandbox ou live) — jamais exposée au client.
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxx
# "sandbox" pour tester, "live" une fois validé par FedaPay.
FEDAPAY_ENVIRONMENT=sandbox
# Secret de signature des webhooks (tableau de bord FedaPay > Webhooks).
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
# false (recommandé au démarrage) = les retraits restent "pending_review" pour
# validation manuelle avant l'appel réel à l'API Payouts de FedaPay.
# true = les retraits sont envoyés automatiquement à FedaPay dès la demande.
WITHDRAWAL_AUTO_APPROVE=false
